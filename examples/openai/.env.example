# Export these in your shell; this file is not loaded automatically.
OPENAI_API_KEY=
OPENAI_MODEL=
PROMPT_FILE=/absolute/path/to/prompt.md
MAX_OUTPUT_TOKENS=1024
# Set current prices for the selected model. Missing prices yield unknown cost.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_CACHED_INPUT_USD_PER_MILLION=
